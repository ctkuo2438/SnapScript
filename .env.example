# Anthropic / Claude API key
# Required only when running with the real provider.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: enable real-provider integration tests.
# Leave unset for normal local tests.
# SNAPSCRIPT_REAL_PROVIDER=1

# Optional: choose sandbox backend.
# Default: docker for Streamlit and MCP, subprocess for the CLI.
# Options: subprocess, docker
# Setting subprocess for Streamlit is an explicit opt-in: generated code is not
# isolated from your files or network, and the UI shows a warning.
# SNAPSCRIPT_SANDBOX_BACKEND=docker

# Optional Docker sandbox settings.
SNAPSCRIPT_DOCKER_IMAGE=snapscript-sandbox:local
# Valid range: 1–30 seconds; larger values are rejected.
SNAPSCRIPT_DOCKER_TIMEOUT_SECONDS=30
SNAPSCRIPT_DOCKER_MEMORY_LIMIT=512m
SNAPSCRIPT_DOCKER_CPU_LIMIT=1.0
SNAPSCRIPT_DOCKER_NETWORK_DISABLED=true

# Optional audit debug mode.
# Default audit logs store metadata/hashes only.
# Do not enable unless debugging locally.
# SNAPSCRIPT_AUDIT_INCLUDE_PROMPTS=1
